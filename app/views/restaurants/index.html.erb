<h1>list of all restaurants</h1>
<ul>
  <% @restaurants.each do |restaurant| %>
  <li> <strong><%= restaurant.name %></strong> , address: <%= restaurant.address %>, phone: <%= restaurant.phone_number %> , category: <%= restaurant.category %> </li>
  <li><%= link_to restaurant.name, restaurant_path(restaurant) %></li>
  <% end %>
</ul>

<%= link_to 'Add Restaurant', new_restaurant_path(@restaurant) %>
