<h1><%= @restaurant.name %></h1>
<ul>
  <li><strong><%= @restaurant.name %></strong>, address: <%= @restaurant.address %>, phone: <%= @restaurant.phone_number %>, category: <%= @restaurant.category %></li>
</ul>
<%= link_to 'Back to Index', restaurants_path %>

<%= link_to 'Add Review', new_restaurant_review_path(@restaurant) %>

<p><strong>Reviews</strong></p>
<ul class="list-group">
  <% @restaurant.reviews.each do |review| %>
    <li class="list-group-item"><%= review.content %></li>
  <% end %>
</ul>
